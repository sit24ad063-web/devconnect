# Database (Postgres — Neon in production, local Postgres via docker-compose in dev)
DATABASE_URL="postgresql://devconnect:devconnect@localhost:5432/devconnect"

# Auth
JWT_SECRET="change-this-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"
COOKIE_NAME="devconnect_token"
NODE_ENV="development"

# GitHub OAuth (create an OAuth App at https://github.com/settings/developers)
# Authorization callback URL: http://localhost:5000/api/auth/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_CALLBACK_URL="http://localhost:5000/api/auth/github/callback"

# Cloudinary (free tier — https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

PORT=5000
CLIENT_URL="http://localhost:5173"
